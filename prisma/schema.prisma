generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// User accounts with role-based access control
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(BUSINESS_USER)
  phone     String?
  avatar    String?
  companyId String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  mailbox   String?
  address   String?
  ruc_id    String?

  // 2FA
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  // Personal finance module — PIN (bcrypt hash) required to unlock the module.
  // Only owners on the email allowlist can set/use it. See lib/finance-auth.ts.
  financePinHash String?

  company Company? @relation(fields: [companyId], references: [id])

  // Commissions module — sales registered by this user (worker) and payouts.
  commissionSales    CommissionSale[]    @relation("WorkerSales")
  commissionPayments CommissionPayment[] @relation("WorkerPayments")

  // Team task board — tasks assigned to / created by this user, and notes.
  assignedTasks TeamTask[] @relation("AssignedTasks")
  createdTasks  TeamTask[] @relation("CreatedTasks")
  teamNotes     TeamNote[] @relation("TeamNotes")

  // Time clock — daily attendance shifts (entrada/almuerzo/salida).
  workShifts WorkShift[] @relation("WorkShifts")

  // Cotizaciones — notas de seguimiento escritas por este usuario.
  quoteNotes QuoteNote[] @relation("QuoteNoteAuthor")

  // Freight — documentos (MBL, DCME, HBL) que este usuario subió.
  uploadedDocuments Document[] @relation("DocumentUploader")

  @@index([email])
  @@index([companyId])
  @@map("users")
}

/// Business entities (logistics companies)
model Company {
  id                 String                  @id @default(cuid())
  name               String
  ruc                String                  @unique
  dv                 String
  address            String
  phone              String
  email              String
  website            String?
  industry           String?
  employees          String?
  established        String?
  isActive           Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  company_id         String?                 @unique
  cargos             Cargo[]
  fclShipments       FclShipment[]
  lclShipments       LclShipment[]
  containerShipments ContainerShipment[]
  users              User[]
  containerClients   CargoManagementClient[]

  @@index([company_id])
  @@index([ruc])
  @@index([isActive])
  @@map("companies")
}

/// Maritime shipping containers
model Container {
  id            String    @id @default(cuid())
  bl            String    @unique
  eta           DateTime
  arrivalDate   DateTime?
  departureDate DateTime?
  shippingLine  String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([bl])
  @@index([eta])
  @@index([shippingLine])
  @@map("containers")
}

/// Individual cargo shipments
model Cargo {
  id        String      @id @default(cuid())
  tracking  String      @unique
  status    CargoStatus @default(IN_TRANSIT)
  type      CargoType   @default(MARITIME)
  companyId String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  company   Company?    @relation(fields: [companyId], references: [id])

  @@index([tracking])
  @@index([status])
  @@index([type])
  @@index([companyId])
  @@map("cargos")
}

/// Container management workflow (extended tracking)
model CargoManagement {
  id              String                  @id @default(cuid())
  containerNumber String
  eta             DateTime?
  location        String
  status          ContainerStatus         @default(RECEIVED_IN_WAREHOUSE)
  shippingLine    String?
  departureDate   DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  referenceNo     String?                 @unique
  statusHistory   StatusHistory[]
  clients         CargoManagementClient[]

  @@index([referenceNo])
  @@index([containerNumber])
  @@index([status])
  @@index([eta])
  @@map("cargo_management")
}

/// Clients (companies) whose cargo is inside a given container
model CargoManagementClient {
  id                String          @id @default(cuid())
  cargoManagementId String
  companyId         String
  cbm               Float?
  notes             String?
  createdAt         DateTime        @default(now())
  cargoManagement   CargoManagement @relation(fields: [cargoManagementId], references: [id], onDelete: Cascade)
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([cargoManagementId, companyId])
  @@index([cargoManagementId])
  @@index([companyId])
  @@map("cargo_management_clients")
}

/// Status history for cargo management tracking
model StatusHistory {
  id                String          @id @default(cuid())
  cargoManagementId String
  status            ContainerStatus
  changedAt         DateTime        @default(now())
  cargoManagement   CargoManagement @relation(fields: [cargoManagementId], references: [id], onDelete: Cascade)

  @@index([cargoManagementId])
  @@index([changedAt])
  @@map("status_history")
}

/// FCL (Full Container Load) shipments
model FclShipment {
  id                  String             @id @default(cuid())
  trackingWarehouse   String
  forwarder           String?
  mailbox             String
  transportType       TransportType      @default(MAR)
  containerNumber     String
  approximateDate     DateTime?
  misidentified       Boolean            @default(false)
  dangerousGoods      Boolean            @default(false)
  refrigeratedProduct Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  companyId           String?
  company             Company?           @relation(fields: [companyId], references: [id])
  itemType            String? // 'company' or 'user' to distinguish selected type
  userId              String? // ID of the user if itemType is 'user'
  totalCbm            Float?
  totalWeight         Float?
  comments            String?
  additionalCode      String?
  pieces              FclShipmentPiece[]

  @@index([trackingWarehouse])
  @@index([containerNumber])
  @@index([mailbox])
  @@index([transportType])
  @@index([companyId])
  @@map("fcl_shipments")
}

/// Individual pieces/packages for FCL shipments
model FclShipmentPiece {
  id            String      @id @default(cuid())
  fclShipmentId String
  fclShipment   FclShipment @relation(fields: [fclShipmentId], references: [id], onDelete: Cascade)
  quantity      Int         @default(1)
  length        Float? // largo en cm
  width         Float? // ancho en cm
  height        Float? // alto en cm
  weight        Float? // peso en kg
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([fclShipmentId])
  @@map("fcl_shipment_pieces")
}

/// LCL (Less than Container Load) shipments
model LclShipment {
  id            String   @id @default(cuid())
  blNumber      String   @unique
  eta           DateTime
  notes         String?
  departureDate DateTime
  cargoAmount   Float    @default(0)
  totalCbm      Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id])
  itemType      String? // 'company' or 'user' to distinguish selected type
  userId        String? // ID of the user if itemType is 'user'

  @@index([blNumber])
  @@index([eta])
  @@index([companyId])
  @@map("lcl_shipments")
}

/// Container shipments
model ContainerShipment {
  id            String   @id @default(cuid())
  blNumber      String   @unique
  eta           DateTime
  notes         String?
  departureDate DateTime
  cargoAmount   Float    @default(0)
  totalCbm      Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id])
  itemType      String? // 'company' or 'user' to distinguish selected type
  userId        String? // ID of the user if itemType is 'user'

  @@index([blNumber])
  @@index([eta])
  @@index([companyId])
  @@map("container_shipments")
}

enum UserRole {
  ADMIN
  WORKER
  BUSINESS_USER
  CUSTOMER_USER
  MBE_MANAGER
}

enum CargoStatus {
  IN_TRANSIT
  ARRIVED_AT_DESTINATION
  READY_FOR_DELIVERY
  DELIVERED
}

enum CargoType {
  MARITIME
  AIR
}

enum ContainerStatus {
  RECEIVED_IN_WAREHOUSE
  IN_TRANSIT
  ARRIVED_PANAMA
  READY_FOR_DELIVERY
}

enum TransportType {
  AIR
  MAR
}

/// Logistics quotes (FCL / LCL)
model Quote {
  id          String      @id @default(cuid())
  quoteNumber String      @unique
  quoteType   QuoteType   @default(FCL)
  status      QuoteStatus @default(DRAFT)

  // Quote header
  tipoServicio   String   @default("Maritimo")
  validoDesde    DateTime
  validoHasta    DateTime
  frecuencia     String?
  tiempoTransito String?
  lineaNaviera   String?
  ruta           String?

  // Shipment info
  cliente                String
  referenciasAdicionales String?
  pesoBruto              Float?
  volumen                String?
  pesoCargable           Float?
  terminoNegociacion     String?
  mercaderia             String?
  valorMercancia         Float?
  valorSeguro            Float?
  piezas                 Float?
  tipoEmbalaje           String?
  dimensiones            String?
  tipoContenedor         String?
  direccionRecogida      String?
  direccionEntrega       String?

  // Service lines: [{service, package, price, qty, amount}]
  servicios   Json    @default("[]")
  comentarios String?
  total       Float   @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String?
  assignedToId    String?
  rejectionReason String?

  @@index([quoteNumber])
  @@index([status])
  @@index([quoteType])
  @@index([createdAt])
  @@index([assignedToId])
  @@map("quotes")
}

enum QuoteType {
  LCL
  FCL
}

/// Extra Manejos — surcharges linked to quotes
model ExtraManejo {
  id         String            @id @default(cuid())
  monto      Float
  motivo     String
  estado     ExtraManejoEstado @default(PENDIENTE)
  fechaCobro DateTime?
  cobradoPor String?

  // Denormalized for fast search/display
  clienteNombre String
  quoteNumber   String
  quoteType     String @default("FAST_QUOTE") // FAST_QUOTE or QUOTE

  // Soft FK — works for both Quote and FastQuote
  fastQuoteId String?
  quoteId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado])
  @@index([clienteNombre])
  @@index([quoteNumber])
  @@index([createdAt])
  @@map("extra_manejos")
}

/// Weekly container bulletin sent to clients
model BoletinEnvio {
  id              String   @id @default(cuid())
  lclContainerId  String
  containerNumber String?
  mblNumber       String
  clienteNombre   String
  clienteEmail    String
  enviadoPor      String
  enviadoAt       DateTime @default(now())

  @@index([lclContainerId])
  @@index([enviadoAt])
  @@map("boletin_envios")
}

enum ExtraManejoEstado {
  PENDIENTE
  COBRADO
}

/// Generic key-value settings for the application
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  CANCELLED
}

enum WarehouseStatus {
  IN_WAREHOUSE
  IN_TRANSIT
  ARRIVED
  DELIVERED
}

/// Warehouse entries for Freight Forwarder module
model WarehouseEntry {
  id       String @id @default(cuid())
  wrNumber String @unique

  clientId   String?
  clientType String? // "user" | "company"
  clientName String

  consigneeName String?

  description  String?
  pieces       Int     @default(1)
  pieceType    String  @default("Cajas")
  weight       Float?
  largo        Float?
  ancho        Float?
  alto         Float?
  unidadMedida String  @default("cm")

  originWarehouse String  @default("CHINA")
  destWarehouse   String?

  status WarehouseStatus @default(IN_WAREHOUSE)

  coordinatorId   String?
  coordinatorName String?

  notes String?

  lclBookingId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wrNumber])
  @@index([status])
  @@index([clientId])
  @@index([createdAt])
  @@map("warehouse_entries")
}

enum LclBookingStatus {
  PENDING
  IN_WAREHOUSE
  ASSIGNED
  SHIPPED
  ARRIVED
  DELIVERED
}

enum LclContainerStatus {
  OPEN
  LOADING
  CLOSED
  IN_TRANSIT
  ARRIVED
  COMPLETED
}

/// LCL Booking — House Bill of Lading
model LclBooking {
  id        String @id @default(cuid())
  hblNumber String @unique

  warehouseEntryId String? @unique

  // Shipper
  shipperName    String
  shipperAddress String?

  // Consignee
  clientId      String?
  clientType    String?
  clientName    String
  clientAddress String?
  clientRuc     String?
  clientDv      String?
  clientEmail   String?

  // Notify Party
  notifyParty   String?
  notifyAddress String?
  notifyRuc     String?
  notifyDv      String?
  notifyEmail   String?
  notifyPhone   String?

  // Forwarding Agent / Party to contact for cargo release (texto libre; el
  // valor por defecto depende del origen, ver lib/hblDefaults).
  forwardingAgent String?

  // Routing
  portOfLoading   String  @default("QINGDAO")
  portOfDischarge String  @default("BALBOA")
  placeOfReceipt  String?
  placeOfDelivery String?
  preCarriageBy   String?
  vessel          String?
  voyage          String?

  // Cargo
  description   String?
  marks         String?
  packages      Int     @default(1)
  packageType   String  @default("CTNS")
  grossWeightKg Float?
  cbm           Float?
  hsCode        String?

  // Freight
  freightTerms    String  @default("PREPAID")
  freightAmount   Float?
  freightCurrency String  @default("USD")
  freightDesc     String?

  // Refs
  exportReference String?
  documentNumber  String?

  status          LclBookingStatus @default(PENDING)
  readyForPickup  Boolean          @default(false)
  pickupWarehouse String? // "PWEST" | "PCENT" | "ZLC"

  /// Con true, el PDF del HBL sale sin el QR de validación. Se usa en los HBL
  /// de origen China, que solo se presentan en origen y no deben exponer la
  /// URL de validación.
  omitQr Boolean @default(false)

  /// Con true, el PDF junta todas las líneas de carga en un solo bloque de
  /// descripción con los totales (estilo Master BL) en vez de una fila por
  /// artículo.
  groupedCargo Boolean @default(false)

  cargoItems LclBookingCargoItem[]

  lclContainerId String?
  lclContainer   LclContainer? @relation(fields: [lclContainerId], references: [id])

  coordinatorId   String?
  coordinatorName String?
  notes           String?
  blDate          DateTime?

  /// Origen del HBL: CHINA (el flujo de siempre) o PANAMA (formato nuevo).
  origin CargoOrigin @default(CHINA)
  /// Sellos aplicados sobre el PDF del HBL: [{ key, anchor, size }]
  stamps Json?

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hblNumber])
  @@index([status])
  @@index([clientId])
  @@index([lclContainerId])
  @@index([origin])
  @@index([createdAt])
  @@map("lcl_bookings")
}

/// LCL Container — groups multiple bookings
model LclContainer {
  id        String @id @default(cuid())
  mblNumber String @unique

  containerNumber String?
  containerType   String?
  seal            String?
  vessel          String?
  voyage          String?

  portOfLoading   String @default("QINGDAO")
  portOfDischarge String @default("BALBOA")

  // Shipper del MBL. Todos los HBL bajo este MBL comparten el mismo proveedor
  // en origen, así que se escribe una vez aquí y el formulario de HBL lo precarga.
  shipperName    String?
  shipperAddress String?

  etd         DateTime?
  eta         DateTime?
  closingDate DateTime?

  status   LclContainerStatus @default(OPEN)
  bookings LclBooking[]

  /// Origen del MBL: CHINA o PANAMA.
  origin CargoOrigin @default(CHINA)

  documents Document[]

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mblNumber])
  @@index([status])
  @@index([createdAt])
  @@index([origin])
  @@map("lcl_containers")
}

/// Fast quote for casillero (maritime/air)
model FastQuote {
  id          String      @id @default(cuid())
  quoteNumber String      @unique
  status      QuoteStatus @default(DRAFT)

  // Datos del cliente
  cliente   String
  direccion String?

  // Medidas de la carga
  medidaLargo Float?
  medidaAncho Float?
  medidaAlto  Float?
  tipoCarga   String?
  tipoEnvio   String  @default("MARITIMO")

  // Volumen (manual)
  cbmFt3        Float?
  unidadVolumen String @default("CBM")

  // Tiempos
  tiempoTransito Int    @default(45)
  validezTarifa  Int    @default(10)
  peso           Float?

  // Servicios (campos fijos)
  flete         Float  @default(0)
  extraManejo   Float?
  entregaPanama Float?
  descuento     Float?

  comentarios String?
  items       Json?
  total       Float   @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     String?
  assignedToId    String?
  rejectionReason String?

  @@index([quoteNumber])
  @@index([status])
  @@index([createdAt])
  @@index([assignedToId])
  @@map("fast_quotes")
}

// ── Supplier Directory ──────────────────────────────────────────────────────

enum SupplierPlatform {
  ALIBABA
  P1688
  MADE_IN_CHINA
  TAOBAO
  DIRECTO
  OTRO
}

model Supplier {
  id            String           @id @default(cuid())
  name          String
  city          String?
  platform      SupplierPlatform @default(OTRO)
  contactWeChat String?
  contactEmail  String?
  contactPhone  String?
  products      String?
  rating        Int              @default(3)
  notes         String?
  linkedCargos  String?
  userId        String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@map("suppliers")
}

// ── Import Checklist ────────────────────────────────────────────────────────

enum ChecklistStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum StepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model ImportChecklist {
  id          String          @id @default(cuid())
  title       String
  productType String?
  status      ChecklistStatus @default(ACTIVE)
  userId      String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  steps       ChecklistStep[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("import_checklists")
}

model ChecklistStep {
  id          String          @id @default(cuid())
  checklistId String
  checklist   ImportChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  name        String
  order       Int
  status      StepStatus      @default(PENDING)
  notes       String?
  completedAt DateTime?

  @@index([checklistId])
  @@map("checklist_steps")
}

// ── Contabilidad / Accounting ────────────────────────────────────────────────

enum OperationCountry {
  CHINA
  PANAMA
  COSTA_RICA
  USA
  OTHER
}

enum ItemTipo {
  ORIGEN
  DESTINO
  INDIRECTO
}

enum ItemMedida {
  GLOBAL
  EVENTO
  KG
  CBM
  TON
  METRO
  HORA
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AccountType {
  REVENUE
  COGS
  OPERATING_EXPENSE
  OTHER_INCOME
  OTHER_EXPENSE
}

enum TransactionCategory {
  FLETE_MARITIMO
  FLETE_AEREO
  TRAMITES_ADUANEROS
  HONORARIOS_AGENTE
  SERVICIOS_PORTUARIOS
  TRANSPORTE_LOCAL
  SEGURO_CARGA
  BANCARIOS
  IMPUESTOS
  ALMACENAJE
  OTROS_LOGISTICA
  INGRESOS_SERVICIO
  OTROS
}

model ShipmentOperation {
  id            String                  @id @default(cuid())
  title         String
  clientName    String
  clientCountry OperationCountry        @default(PANAMA)
  clientPhone   String?
  shipmentRef   String?
  shipmentType  String                  @default("FCL")
  pol           String?
  pod           String?
  polDate       DateTime?
  podDate       DateTime?
  cbm           Float?
  ingresoTotal  Float                   @default(0)
  notes         String?
  userId        String
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  items         ShipmentOperationItem[]
  transactions  AccountingTransaction[]

  @@index([userId])
  @@index([createdAt])
  @@map("shipment_operations")
}

model ShipmentOperationItem {
  id            String            @id @default(cuid())
  operationId   String
  operation     ShipmentOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  tipo          ItemTipo          @default(ORIGEN)
  descripcion   String
  medida        ItemMedida        @default(EVENTO)
  cantidad      Float             @default(1)
  costoUnit     Float             @default(0)
  costoTotal    Float             @default(0)
  isHighlighted Boolean           @default(false)
  order         Int               @default(0)
  notes         String?

  @@index([operationId])
  @@map("shipment_operation_items")
}

model AccountingTransaction {
  id          String              @id @default(cuid())
  type        TransactionType
  category    TransactionCategory @default(OTROS)
  accountType AccountType         @default(OPERATING_EXPENSE)
  origin      OperationCountry    @default(PANAMA)
  description String
  amount      Float
  currency    String              @default("USD")
  date        DateTime            @default(now())
  reference   String?
  operationId String?
  operation   ShipmentOperation?  @relation(fields: [operationId], references: [id], onDelete: SetNull)
  userId      String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId])
  @@index([type])
  @@index([date])
  @@index([operationId])
  @@map("accounting_transactions")
}

// ── Appointment Scheduling ──────────────────────────────────────────────────

enum AppointmentServiceType {
  ENTREGA_CARGA
  RETIRO_CARGA
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

/// Physical warehouse locations with configurable schedule
model Warehouse {
  id             String  @id @default(cuid())
  name           String
  code           String  @unique
  address        String?
  phone          String?
  isActive       Boolean @default(true)
  scheduleConfig Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@index([code])
  @@index([isActive])
  @@map("warehouses")
}

/// Scheduled warehouse appointments
model Appointment {
  id         String @id @default(cuid())
  apptNumber String @unique

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  serviceType AppointmentServiceType

  appointmentDate DateTime
  appointmentTime String

  clientName  String
  clientEmail String
  clientPhone String
  clientRuc   String?
  companyName String?

  description String?
  pieces      Int?
  weight      Float?

  paymentProofUrl String?

  status       AppointmentStatus @default(CONFIRMED)
  notes        String?
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([apptNumber])
  @@index([warehouseId])
  @@index([appointmentDate])
  @@index([status])
  @@index([clientEmail])
  @@map("appointments")
}

// =====================================================================
// PERSONAL FINANCE MODULE ("Finanzas Personales" / contabilidad personal)
// Private to the owners (email allowlist) — see lib/finance-auth.ts.
// `PersonalLedgerEntry` is the single master journal ("Registro Diario");
// every dashboard/summary is computed from it. Catalog values (units,
// categories, methods) live in `PersonalLedgerCatalog` so they're editable
// without migrations. `PersonalLedgerAudit` records every change.
// =====================================================================

enum LedgerType {
  INGRESO
  EGRESO
}

enum LedgerStatus {
  PAGADO
  PENDIENTE
  PARCIAL
  ANULADO
}

/// Separates business money from personal money. `unit` says WHICH pot the
/// money moved through (Shippy, Contenedores Valdai...); `scope` says whether
/// it was a business movement or a personal one. Both are needed: the owner
/// pays personal expenses out of business pots, so "cuánto deja Valdai" is
/// wrong unless the personal spend is excluded.
enum LedgerScope {
  NEGOCIO
  PERSONAL
}

/// Master daily journal — one row per money movement (income or expense).
model PersonalLedgerEntry {
  id            String             @id @default(cuid())
  date          DateTime // fecha del movimiento
  unit          String // Unidad: Shippy, TrackingPTY, CNC, Salario Personal, Dividendos Empresa, Contenedores Valdai, Ventas Adicionales...
  scope         LedgerScope        @default(NEGOCIO) // Negocio / Personal
  /// False when `scope` is a guess nobody confirmed yet. The 2026 backfill
  /// could classify most rows by rule, but things like "gasolina" or
  /// "GASTOS MANUEL" are genuinely ambiguous — they default to NEGOCIO and get
  /// flagged here so the owner can settle them, instead of silently skewing
  /// the P&L. Anything saved from the form is reviewed by definition.
  scopeReviewed Boolean            @default(true)
  type          LedgerType // Ingreso / Egreso
  category      String // Categoría (Venta servicio, Flete, Comida, Salario, Dividendos...)
  subcategory   String?
  method        String? // Método: Efectivo, Transferencia, ACH, Yappy, Tarjeta, Cheque, Otro
  status        LedgerStatus       @default(PAGADO)
  counterparty  String? // Cliente / Proveedor
  reference     String? // Referencia / Contenedor
  description   String?
  amount        Float // monto (positivo; el signo lo da `type`)
  /// Job this movement belongs to. Optional: personal spend and overhead
  /// belong to no operation.
  operationId   String?
  operation     PersonalOperation? @relation(fields: [operationId], references: [id], onDelete: SetNull)

  receiptUrl String? // comprobante
  notes      String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([unit])
  @@index([scope])
  @@index([operationId])
  @@index([type])
  @@index([status])
  @@index([category])
  @@map("personal_ledger_entries")
}

/// Editable dropdown catalogs for the personal finance module.
model PersonalLedgerCatalog {
  id        String   @id @default(cuid())
  kind      String // 'unit' | 'category' | 'method'
  value     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([kind, value])
  @@index([kind])
  @@map("personal_ledger_catalog")
}

/// Audit trail for the personal finance module.
model PersonalLedgerAudit {
  id        String   @id @default(cuid())
  entityId  String? // affected ledger entry, when applicable
  action    String // 'create' | 'update' | 'delete' | 'unlock' | 'pin_set' | 'access'
  userId    String?
  userEmail String?
  detail    Json? // snapshot / diff / context
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entityId])
  @@map("personal_ledger_audit")
}

// ===========================================================================
// Commissions module ("Ventas y Comisiones")
// Workers register sales; a configurable rule per sale type computes the
// commission as a FIXED amount or a PERCENT of the sale. Every sale records
// the worker who created it. Admins settle pending commissions as payouts.
// ===========================================================================

/// Configurable commission rule per sale type (FIXED $ or PERCENT of sale).
model CommissionRule {
  id        String         @id @default(cuid())
  saleType  String         @unique // 'FCL' | 'LCL' | 'SEGURO' | 'COTIZACION_ALIBABA' | custom
  label     String // human label shown in the UI
  mode      CommissionMode // FIXED or PERCENT
  value     Float          @default(0) // fixed $ amount, or percent number (e.g. 10 = 10%)
  active    Boolean        @default(true)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("commission_rules")
}

/// A registered sale and its computed commission, tied to the worker.
model CommissionSale {
  id          String  @id @default(cuid())
  saleType    String // matches a CommissionRule.saleType (snapshot below)
  saleLabel   String // label of the sale type at time of creation
  clientName  String
  description String?
  saleAmount  Float   @default(0)

  // Commission snapshot — frozen at creation so later rule edits don't change history.
  commissionMode   CommissionMode
  commissionValue  Float          @default(0) // fixed $ or percent number used
  commissionAmount Float          @default(0) // resolved $ commission

  status CommissionStatus @default(PENDING)
  paidAt DateTime?

  // Worker who registered the sale (denormalized name/email kept for history).
  workerId    String?
  workerName  String
  workerEmail String?

  paymentId String? // CommissionPayment that settled this sale, if any

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  worker User? @relation("WorkerSales", fields: [workerId], references: [id], onDelete: SetNull)

  @@index([workerId])
  @@index([status])
  @@index([saleType])
  @@map("commission_sales")
}

/// A commission payout that settles one or more pending sales for a worker.
model CommissionPayment {
  id         String   @id @default(cuid())
  workerId   String?
  workerName String
  amount     Float    @default(0)
  note       String?
  paidById   String? // admin who registered the payout
  paidByName String?
  createdAt  DateTime @default(now())

  worker User? @relation("WorkerPayments", fields: [workerId], references: [id], onDelete: SetNull)

  @@index([workerId])
  @@map("commission_payments")
}

enum CommissionMode {
  FIXED
  PERCENT
}

enum CommissionStatus {
  PENDING
  PAID
}

// ===========================================================================
// Team task board ("Tablero de Tareas")
// A shared Kanban board: tasks assigned to people across status columns, plus
// sticky notes for important reminders the whole team can see.
// ===========================================================================

/// A task card on the shared team board.
model TeamTask {
  id          String           @id @default(cuid())
  title       String
  description String?
  status      TeamTaskStatus   @default(TODO)
  priority    TeamTaskPriority @default(MEDIUM)
  dueDate     DateTime?
  sortOrder   Int              @default(0) // order within its column

  assigneeId   String?
  assigneeName String?

  createdById   String?
  createdByName String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  assignee  User? @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User? @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([assigneeId])
  @@map("team_tasks")
}

/// A sticky note pinned to the team board (important reminders).
model TeamNote {
  id         String   @id @default(cuid())
  content    String
  color      String   @default("yellow") // sticky color: yellow | pink | blue | green | orange
  pinned     Boolean  @default(false)
  authorId   String?
  authorName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author User? @relation("TeamNotes", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([pinned])
  @@map("team_notes")
}

enum TeamTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TeamTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ===========================================================================
// Time clock / attendance ("Reporte de Entrada y Salida")
// One row per worker per day; four punches: clock-in, lunch-out, lunch-in,
// clock-out. Workers mark their own day; admins see the team report.
// ===========================================================================

/// A worker's attendance for a single day.
model WorkShift {
  id         String    @id @default(cuid())
  userId     String
  userName   String
  workDate   String // local date key 'YYYY-MM-DD' for one-shift-per-day
  clockIn    DateTime?
  lunchStart DateTime?
  lunchEnd   DateTime?
  clockOut   DateTime?
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User? @relation("WorkShifts", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workDate])
  @@index([userId])
  @@index([workDate])
  @@map("work_shifts")
}

// =====================================================================
// PRÉSTAMOS PERSONALES (privado)
// ---------------------------------------------------------------------
// A `PersonalLoan` is any debt with a payment plan: personal loans
// (Yesenia, Carlos), bank loans (auto) and property plans (Finca
// Emperador). Money actually handed over lives in `PersonalLoanPayment`;
// the balance is always derived (`totalAmount - downPayment - Σpayments`)
// so it can never drift out of sync with the payment history.
// Payments registered from the app also post an EGRESO into
// `PersonalLedgerEntry` and keep the link in `ledgerEntryId`.
// =====================================================================

enum LoanKind {
  PERSONAL
  BANCARIO
  PROPIEDAD
}

enum LoanStatus {
  ACTIVO
  PAGADO
  CANCELADO
}

enum LoanPaymentKind {
  CUOTA
  EXTRAORDINARIO
  INICIAL
  AJUSTE
}

/// A debt with a payment plan. Balance is derived from `payments`.
model PersonalLoan {
  id           String     @id @default(cuid())
  name         String // "Préstamo Yesenia", "Finca Emperador"
  kind         LoanKind   @default(PERSONAL)
  status       LoanStatus @default(ACTIVO)
  counterparty String? // Yesenia, Carlos, banco...
  reference    String? // nº de préstamo / contrato

  principal   Float // capital sin interés
  interest    Float @default(0) // interés y cargos
  totalAmount Float // total a pagar (lo que cierra el plan)
  downPayment Float @default(0) // abono inicial ya entregado

  installmentAmount Float? // cuota
  installmentsTotal Int? // nº de cuotas del plan
  interestRate      Float?
  startDate         DateTime?
  firstPaymentDate  DateTime?
  dueDate           DateTime?

  /// Defaults used when a payment posts its EGRESO into the daily ledger.
  unit     String?
  category String?

  notes String?

  payments PersonalLoanPayment[]

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([kind])
  @@map("personal_loans")
}

/// One payment against a loan.
model PersonalLoanPayment {
  id     String       @id @default(cuid())
  loanId String
  loan   PersonalLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  date   DateTime
  amount Float
  kind   LoanPaymentKind @default(CUOTA)

  /// Fondo del que salió el dinero (unidad del libro: Salario Personal,
  /// Dividendos Empresa, Contenedores Valdai...). Es la `unit` del egreso.
  sourceUnit String?

  method    String?
  reference String?
  notes     String?

  /// Set when this payment also posted a movement in the daily journal.
  ledgerEntryId String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([loanId])
  @@index([date])
  @@map("personal_loan_payments")
}

// =====================================================================
// OPERACIONES (contenedores Valdai y similares)
// ---------------------------------------------------------------------
// A `PersonalOperation` is one money-making job — typically a container.
// It exists because the free-text `reference` field could not group a job's
// income with its costs: the same container was written
// "Contenedor [9507100400]: ETA [29/JUNIO]  COLCHON" on the income and
// "...[29/JUNIO] COLCHON" (one space) on the expense, and the colchones job
// was called "2 contenedores colchones 1 triciclos" on one side and
// "3 contenedores 2 colchones 1 triciclos" on the other. Grouping by that
// string splits one job in two and reports a fake profit.
//
// `reference` is deliberately kept as-is on every entry: it is the owner's
// original note and the audit trail for how a row got linked here.
// =====================================================================

enum OperationStatus {
  ABIERTA
  CERRADA
}

/// One revenue-generating job; P&L is derived from its linked entries.
model PersonalOperation {
  id              String          @id @default(cuid())
  name            String // "Contenedor 9507100400 — Colchones"
  containerNumber String? // 9507100400
  unit            String? // unidad del libro a la que pertenece (Contenedores Valdai...)
  status          OperationStatus @default(ABIERTA)
  eta             DateTime?
  startDate       DateTime?
  closedAt        DateTime?
  notes           String?

  entries PersonalLedgerEntry[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([containerNumber])
  @@map("personal_operations")
}

// ════════════════════════════════════════════════════════════════════════════
// SEGURO DE CARGA — cotizaciones y seguimiento
// ════════════════════════════════════════════════════════════════════════════

/// Cotización de seguro de carga emitida.
///
/// La tarifa (tasa y prima mínima) se congela al emitir: reimprimir una
/// cotización vieja da el mismo documento aunque el tarifario haya cambiado.
model InsuranceQuote {
  id          String      @id @default(cuid())
  quoteNumber String      @unique
  status      QuoteStatus @default(DRAFT)

  cliente          String
  referencia       String?
  descripcionCarga String?

  // Valores declarados
  valorComercial Float @default(0)
  valorFlete     Float @default(0)
  valorTributos  Float @default(0)

  gastosAdicionalesPct Float @default(0)
  lucroSesantePct      Float @default(0)

  // Tarifa aplicada (congelada al emitir)
  clienteType String @default("regular") // regular | agente | custom
  rateLabel   String
  rate        Float
  minimum     Float

  // Resultado del cálculo
  base              Float @default(0)
  gastosAdicionales Float @default(0)
  lucroSesante      Float @default(0)
  totalAsegurado    Float @default(0)
  prima             Float @default(0)
  valorCobrar       Float @default(0)

  comentarios     String?
  rejectionReason String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([quoteNumber])
  @@index([status])
  @@index([createdAt])
  @@map("insurance_quotes")
}

/// A qué tipo de cotización pertenece una nota de seguimiento.
enum QuoteNoteEntity {
  QUOTE
  FAST_QUOTE
  INSURANCE_QUOTE
}

/// Nota de seguimiento de una cotización (quién llamó al cliente y qué dijo).
///
/// No apunta con llave foránea a una tabla concreta porque sirve a las tres
/// clases de cotización; `entity` dice cuál y `entityId` cuál fila.
model QuoteNote {
  id       String          @id @default(cuid())
  entity   QuoteNoteEntity
  entityId String

  body String

  createdById String?
  createdBy   User?    @relation("QuoteNoteAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([entity, entityId, createdAt])
  @@map("quote_notes")
}

// ════════════════════════════════════════════════════════════════════════════
// FREIGHT FORWARDING — origen, líneas de carga y documentos
// ════════════════════════════════════════════════════════════════════════════

/// De dónde sale el embarque. Decide el formato y los valores por defecto del
/// HBL: los de Panamá llevan otro agente de carga y otro notify.
enum CargoOrigin {
  CHINA
  PANAMA
}

/// Una línea de carga del HBL.
///
/// Antes la mercancía era un solo bloque de texto en `description`, así que un
/// HBL con tres productos de distinto HS code no se podía declarar bien. Cada
/// línea lleva su propio código, bultos, peso y volumen.
model LclBookingCargoItem {
  id           String     @id @default(cuid())
  lclBookingId String
  lclBooking   LclBooking @relation(fields: [lclBookingId], references: [id], onDelete: Cascade)

  hsCode        String?
  description   String
  packages      Int     @default(1)
  packageType   String?
  grossWeightKg Float?
  cbm           Float?
  marks         String?

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lclBookingId])
  @@map("lcl_booking_cargo_items")
}

enum DocumentKind {
  MBL
  DCME
  HBL
  OTHER
}

/// Archivo adjunto a un MBL o a un HBL.
model Document {
  id           String       @id @default(cuid())
  kind         DocumentKind @default(OTHER)
  originalName String
  storedName   String       @unique // nombre en disco (uuid.ext)
  mimeType     String
  size         Int

  uploadedById String?
  uploadedBy   User?   @relation("DocumentUploader", fields: [uploadedById], references: [id])

  lclContainerId String?
  lclContainer   LclContainer? @relation(fields: [lclContainerId], references: [id], onDelete: Cascade)

  lclBookingId String?
  lclBooking   LclBooking? @relation(fields: [lclBookingId], references: [id], onDelete: Cascade)

  notes     String?
  createdAt DateTime @default(now())

  @@index([lclContainerId])
  @@index([lclBookingId])
  @@index([kind])
  @@map("documents")
}

/// Correlativo de cada serie de HBL/MBL (una fila por prefijo y año).
///
/// Vive aparte de los documentos a propósito: si el correlativo se dedujera de
/// las filas, borrar el último haría que el siguiente reemitiera ese número.
model BlCounter {
  prefix  String @id // HBLCH26, MBLPA26…
  lastSeq Int    @default(0)

  /// Lo escribe la consulta que reserva el número (SQL crudo), no Prisma.
  updatedAt DateTime @default(now())

  @@map("bl_counters")
}
